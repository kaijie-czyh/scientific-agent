# 科研论文 Agent 系统 — 环境变量配置
#
# 使用方法：
#   1. 复制本文件为 .env
#   2. 填入你的 API key
#   3. 系统启动时自动从 .env 与系统环境变量读取
#
# 当前用户方案：只开 MiniMax Plus（¥49/月，6亿+ token M3/月，1M 上下文）
# 其他 provider 配置保留但不启用，便于后续扩展。

# ===== MiniMax Token Plan（主力，必填）=====
# 获取 sk-cp key：https://platform.minimaxi.com/console/plan
# 注意：国内版 key (platform.minimaxi.com) 必须配国内版 endpoint (api.minimaxi.com)
#       国际版 key (platform.minimax.io) 配国际版 endpoint (api.minimax.io)
#       key 与 endpoint 必须匹配，否则会报 401 invalid api key
MINIMAX_API_KEY=REPLACE_WITH_YOUR_OWN_KEY
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# Spark-X2-Flash（真实密钥只填写到被 Git 忽略的 .env）
SPARK_API_KEY=your-spark-ak-sk-here
SPARK_BASE_URL=https://spark-api-open.xf-yun.com/agent/v1/

# 硅基流动（OpenAI 兼容接口；真实密钥只填写到被 Git 忽略的 .env）
SILICONFLOW_API_KEY=your-siliconflow-api-key-here
SILICONFLOW_BASE_URL=https://api.siliconflow.cn/v1

# ===== 可选 provider（未开通留空即可，系统会自动跳过）=====
# 小米 MiMo（夜间 0.8x 消耗，1M 上下文，适合长文档写作）
# MIMO_API_KEY=
# MIMO_BASE_URL=https://api.mimo.xiaomi.com/v1

# DeepSeek V4（编程/推理补强，按量计费）
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1

# OpenAI（嵌入模型用，MiniMax 暂无嵌入 API；未配置时向量检索降级为关键词检索）
# OPENAI_API_KEY=

# Anthropic Claude（可选）
# ANTHROPIC_API_KEY=

# 本地模型（敏感任务路由，兼容 OpenAI 协议，如 vLLM/Ollama）
# LOCAL_LLM_BASE_URL=http://localhost:8000/v1

# ===== 系统配置 =====
# dry_run=true 时不执行真实 LLM 调用，全部用占位数据返回（默认 true，用于架构验证）
# 设为 false 后才会真实调用 MiniMax API
SRA_DRY_RUN=true

# tasks.yaml 路径覆盖（可选）
# SRA_TASKS_CONFIG_PATH=config/tasks.yaml

# ===== 科学文献检索工具（赛题推荐，可选）=====
# Sciverse 科学智能数据库（GOAI 赛道三·方向三推荐）
# 465M knowledge records, 证据片段级检索（非仅论文列表）
# 获取免费 Token：https://sciverse.opendatalab.com/tokens
# 未配置时自动降级为 arxiv + Semantic Scholar
# SCIVERSE_API_TOKEN=your-sciverse-token-here

# ===== Materials Project API（赛题路线 A 硬要求，可选）=====
# 路线 A「构效关系发现」要求与公开数据库交叉验证
# 获取免费 API key：https://next-gen.materialsproject.org/api
# 未配置时自动降级为规则交叉验证（基于已知热电材料体系物理范围）
# MATERIALS_PROJECT_API_KEY=your-mp-api-key-here

# ===== 实验执行模式（可选）=====
# 默认 local：在本地 subprocess 运行实验代码
# 设为 remote 时通过 SSH 在远程机器运行（需免密登录）
# SRA_EXECUTION_MODE=local
# SRA_REMOTE_SSH_HOST=user@remote-host
# SRA_REMOTE_SSH_KEY=~/.ssh/id_rsa
# SRA_REMOTE_SSH_PORT=22
# SRA_REMOTE_WORKDIR=/tmp/sra_experiments
