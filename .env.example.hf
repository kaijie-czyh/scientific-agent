# 科研论文 Agent 系统 — Hugging Face Spaces 部署版环境变量
#
# 不要在本文件填真实 key！HF Spaces 请使用：
#   Settings -> Variables and secrets -> New secret
# 填入以下变量名即可，系统启动时会自动从环境读取。
#
# 说明：web/api.py 通过 runtime/cli._load_env() 读取 .env 与系统环境变量，
# 在 HF Spaces 中未配置的变量会保持为空，功能自动降级。

# ===== MiniMax（比赛 demo 的 LLM 主力，必填）=====
# 注意：key 与 endpoint 必须匹配（国内版 key 配 api.minimaxi.com）
# 获取：https://platform.minimaxi.com/console/plan
MINIMAX_API_KEY=
MINIMAX_BASE_URL=https://api.minimaxi.com/v1

# ===== 科学文献检索（可选，未配置自动降级 arxiv + Semantic Scholar）=====
# Sciverse token：https://sciverse.opendatalab.com/tokens
SCIVERSE_API_TOKEN=

# ===== 材料数据库（可选）=====
# Materials Project API key：https://next-gen.materialsproject.org/api
MATERIALS_PROJECT_API_KEY=

# ===== 可选 provider（未配置自动跳过）=====
# MIMO_API_KEY=
# MIMO_BASE_URL=https://api.mimo.xiaomi.com/v1
# DEEPSEEK_API_KEY=
# DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
# OPENAI_API_KEY=
# ANTHROPIC_API_KEY=

# ===== 运行模式 =====
# demo 默认 dry_run=false，真实调用 LLM（有 key 时），否则占位数据可完整走通流程
SRA_DRY_RUN=false